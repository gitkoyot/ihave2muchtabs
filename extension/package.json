{
  "name": "ihave2muchtabs-extension",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs --target chrome",
    "build:chrome": "node ./scripts/build.mjs --target chrome",
    "build:firefox": "node ./scripts/build.mjs --target firefox",
    "build:edge": "node ./scripts/build.mjs --target edge",
    "package:chrome": "node ./scripts/build.mjs --target chrome --package",
    "package:firefox": "node ./scripts/build.mjs --target firefox --package",
    "package:all": "node ./scripts/build.mjs --target chrome --package && node ./scripts/build.mjs --target firefox --package",
    "build:all": "node ./scripts/build.mjs --target chrome && node ./scripts/build.mjs --target firefox && node ./scripts/build.mjs --target edge",
    "watch": "node ./scripts/build.mjs --watch --target chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.6"
  }
}
